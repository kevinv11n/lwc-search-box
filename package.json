{
  "name": "lwc-search-box",
  "lwc": {
    "modules": [
      {
        "dir": "src/modules"
      }
    ]
  },
  "version": "0.0.0",
  "author": "Kevin Venkiteswaran @kevinv11n",
  "main": "dist/app.js",
  "bugs": "https://github.com/kevinv11n/lwc-search-box/issues",
  "dependencies": {
    "lwc-services": "^3.2.2"
  },
  "devDependencies": {
    "eslint": "^7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "homepage": "https://github.com/kevinv11n/lwc-search-box",
  "keywords": [
    "lwc"
  ],
  "license": "MIT",
  "lint-staged": {
    "**/*.{html,js,json,yaml,yml,md}": [
      "prettier --write"
    ],
    "**/modules/**": [
      "eslint"
    ]
  },
  "repository": "kevinv11n/lwc-search-box",
  "scripts": {
    "build": "NODE_OPTIONS=--openssl-legacy-provider lwc-services build -m production",
    "build:development": "NODE_OPTIONS=--openssl-legacy-provider lwc-services build",
    "lint": "eslint ./src/**/*.js",
    "prettier": "prettier --write '**/*.{css,html,js,json,md,yaml,yml}'",
    "prettier:verify": "prettier --list-different '**/*.{css,html,js,json,md,yaml,yml}'",
    "serve": "NODE_OPTIONS=--openssl-legacy-provider lwc-services serve",
    "test:unit": "lwc-services test:unit",
    "test:unit:coverage": "lwc-services test:unit --coverage",
    "test:unit:debug": "lwc-services test:unit --debug",
    "test:unit:watch": "lwc-services test:unit --watch",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider lwc-services watch",
    "prepare": "husky"
  }
}
